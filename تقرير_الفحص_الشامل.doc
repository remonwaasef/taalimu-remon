  body { font-family: Arial, "Segoe UI", Tahoma, sans-serif; direction: rtl; font-size: 11pt; color: #1a1a1a; }
  h1 { font-size: 20pt; color: #1f3864; border-bottom: 3pt solid #1f3864; padding-bottom: 6pt; }
  h2 { font-size: 15pt; color: #1f3864; border-bottom: 1pt solid #8faadc; padding-bottom: 3pt; margin-top: 24pt; }
  h3 { font-size: 12.5pt; color: #2e5395; margin-top: 16pt; }
  table { border-collapse: collapse; width: 100%; font-size: 10pt; margin: 8pt 0; }
  th { background: #1f3864; color: #fff; padding: 6pt; border: 1pt solid #999; text-align: right; }
