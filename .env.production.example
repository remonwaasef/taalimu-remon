APP_NAME="taalimu"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://yourdomain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ===========================================
# DATABASE CONFIGURATION (500K Users Ready)
# ===========================================
DB_CONNECTION=mysql
DB_HOST=primary-db.yourdomain.com
DB_PORT=3306
DB_DATABASE=your_production_database
DB_USERNAME=your_db_user
DB_PASSWORD=your_secure_password

# Read Replicas for Load Distribution (comma-separated)
DB_READ_HOST=replica1-db.yourdomain.com,replica2-db.yourdomain.com

# ===========================================
# CACHING & SESSION (Redis Required for Scale)
# ===========================================
BROADCAST_DRIVER=redis
CACHE_STORE=redis
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com
# SameSite=lax (NOT strict): payment providers (Paymob/PayPal) redirect the
# user's browser back to the app after checkout — a cross-site top-level
# navigation. With "strict" the session cookie is withheld there and the
# callback flow (which reads tenant/plan from the session) breaks.
SESSION_SAME_SITE=lax

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis.yourdomain.com
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379
REDIS_PREFIX=edu_

# Redis Retry Configuration (High Availability)
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000

# ===========================================
# MAIL CONFIGURATION
# ===========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.yourdomain.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# AWS S3 CONFIGURATION (Recommended for Scale)
# ===========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=edu-saas-storage
AWS_USE_PATH_STYLE_ENDPOINT=false

# ===========================================
# PUSHER/BROADCASTING
# ===========================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ===========================================
# TENANT CONFIGURATION
# ===========================================
TENANT_ROUTE_PATTERN={tenant}.yourdomain.com
TENANT_DOMAIN=yourdomain.com

# ===========================================
# PERFORMANCE & SECURITY
# ===========================================
BCRYPT_ROUNDS=12
PAGINATION_LIMIT=25
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=300

# ===========================================
# ERROR MONITORING (Sentry)
# ===========================================
# Package already installed. Paste your production DSN to capture exceptions.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
