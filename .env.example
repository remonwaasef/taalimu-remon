#--------------------------------------------------------------------------
# Taalimu - SaaS Educational Platform
#--------------------------------------------------------------------------
# Copy this file to .env and fill in the values for your environment.
# For detailed setup instructions, see DEPLOYMENT_GUIDE.md
#--------------------------------------------------------------------------

#--------------------------------------------------------------------------
# Application Settings
#--------------------------------------------------------------------------
APP_NAME="Taalimu"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://taalimu.com

# Comma-separated trusted proxy IPs for production behind a load balancer
# e.g. TRUSTED_PROXIES=10.0.0.1,203.0.113.5
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance mode driver: 'file' or 'cache'
APP_MAINTENANCE_DRIVER=file

#--------------------------------------------------------------------------
# Hashing
#--------------------------------------------------------------------------
BCRYPT_ROUNDS=12

#--------------------------------------------------------------------------
# Logging
#--------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#--------------------------------------------------------------------------
# Database Configuration
#--------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taalimu
DB_USERNAME=root
DB_PASSWORD=

#--------------------------------------------------------------------------
# Session Configuration
#--------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_PATH=/
# Set to null for local dev. For production: .yourdomain.com (with leading dot)
SESSION_DOMAIN=null
# Set to true in production (requires HTTPS)
SESSION_SECURE_COOKIE=true

#--------------------------------------------------------------------------
# Caching & Queue
#--------------------------------------------------------------------------
# For local dev: file/sync. For production: redis/redis
CACHE_STORE=file
QUEUE_CONNECTION=sync
CACHE_PREFIX=taalimu_cache_

MEMCACHED_HOST=127.0.0.1

#--------------------------------------------------------------------------
# Redis Configuration
# Required for production. For local dev, can use file driver instead.
#--------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

#--------------------------------------------------------------------------
# Multi-Tenancy Configuration
#--------------------------------------------------------------------------
# The base domain for tenant subdomains
# Local dev: localhost | Production: yourdomain.com (without http/https)
TENANT_DOMAIN=localhost

# Legacy route pattern (auto-detected, rarely needs manual setting)
# TENANT_ROUTE_PATTERN={tenant}.localhost

# Tenancy Mode: 'subdomain' or 'path'
# subdomain: center1.domain.com (requires VPS/Cloud hosting with wildcard DNS)
# path: domain.com/c/center1 (works on any shared hosting)
TENANCY_MODE=subdomain

#--------------------------------------------------------------------------
# Mail Configuration
#--------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=tls

#--------------------------------------------------------------------------
# Feature Flags
#--------------------------------------------------------------------------
# Enable automated onboarding email sequence for new tenants
ENABLE_ONBOARDING_EMAILS=true

#--------------------------------------------------------------------------
# AWS Configuration (Optional - for S3 file storage)
#--------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#--------------------------------------------------------------------------
# Vite (Frontend Build)
#--------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# Laravel Reverb (WebSocket - Real-time)
#--------------------------------------------------------------------------
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

#--------------------------------------------------------------------------
# Google OAuth (Social Login)
#--------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback

#--------------------------------------------------------------------------
# Telegram Bot (Admin Notifications)
# Create a bot via @BotFather on Telegram to get the token.
# Get your chat ID by sending a message to @userinfobot
#--------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

#--------------------------------------------------------------------------
# Stripe Configuration (International Payments)
# Get keys from: https://dashboard.stripe.com/apikeys
#--------------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
# Set to true to bypass real Stripe calls during development
STRIPE_DEMO_MODE=true

#--------------------------------------------------------------------------
# PayPal Configuration (International Payments)
# Get keys from: https://developer.paypal.com/dashboard/applications
#--------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 'sandbox' for testing, 'live' for production
PAYPAL_MODE=sandbox

#--------------------------------------------------------------------------
# Paymob Configuration (Egypt Local Payments)
# Get keys from: https://accept.paymob.com/portal2/en/settings
#--------------------------------------------------------------------------
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_MERCHANT_ID=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=
PAYMOB_IFRAME_ID=

#--------------------------------------------------------------------------
# Sentry (error monitoring) — package already installed.
# Paste the DSN from your Sentry project to start capturing exceptions.
# Leave empty to disable.
#--------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
